class Solution {
    public int[] twoSum(int[] nums, int target) {
        int n= nums.length;
        for(int i=0;i<=n-1;i++)
        {for(int j=i+1;j<n;j++){
           if(nums[i]+nums[j]==target){
             int ans[]={i,j};
             return ans;
           }
        }

        }
         
        
        int ans[]={};
        return ans;
    }
}
//2
class Solution {
    public int removeDuplicates(int[] nums) {
        int i=0;
        int j=1;
        int n= nums.length;
        while(j<n)
        {
            if(nums[i]==nums[j])
            {
                j++;
            }
        
        else
        {
            i++;
            nums[i]=nums[j];
            j++;
        }
        }

        
  return i+1;  }
}
